[Unit]
Description=ARS gatt — 1 nRF: Bluetooth laptop <-> Remote nRF52840 qua kết nối BLE GATT (NUS) <-> MQTT
After=bluetooth.service mosquitto.service
Wants=bluetooth.service mosquitto.service

[Service]
User=ars
Group=ars
SupplementaryGroups=bluetooth
WorkingDirectory=/opt/ars-server
Environment=ARS_CONFIG=/opt/ars-server/config.ini
Environment=PYTHONUNBUFFERED=1
# Bluetooth bị tắt bằng phím/công tắc phần mềm thì bật lại (chạy bằng root nhờ dấu +)
ExecStartPre=+-/usr/sbin/rfkill unblock bluetooth
ExecStart=/usr/bin/python3 /opt/ars-server/bridge/ble_gatt.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
